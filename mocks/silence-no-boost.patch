From d83e90f8db1456c406530ed953f89cc4a4ca0779 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 18:13:55 -0500
Subject: [PATCH 2/2] MOCK, not for main: silencing as on main, but it says
 nothing about the silenced person

Off mock/inert-breathstealer with the ability back on. The public silencing factor
(PublicEvidence, odds x0.66 of evil) is set to 1, and silenced people stay in the
circumstantial reference pool. Only Breathstealer deals are played.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HbG76j4nGBcu8ZaA1UKmdr
---
 sim/roles/breathstealer.gd  | 2 +-
 workshop/circumstantial.gd  | 2 +-
 workshop/public_evidence.gd | 1 +
 3 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/sim/roles/breathstealer.gd b/sim/roles/breathstealer.gd
index 00da84a..224ede9 100644
--- a/sim/roles/breathstealer.gd
+++ b/sim/roles/breathstealer.gd
@@ -15,7 +15,7 @@ func _init() -> void:
 
 ## MOCK (mock/inert-breathstealer, not for main): an ability-less Minion. Dealt and played as
 ## a Breathstealer (team knowledge, bluffs, votes) but it never silences and never hunts.
-const INERT := true
+const INERT := false
 
 const PUBLIC: Array = ["tavern", "well", "chapel", "bakery", "wharf", "smithy", "mill", "graveyard"]
 
diff --git a/workshop/circumstantial.gd b/workshop/circumstantial.gd
index 7bfb611..0c894cc 100644
--- a/workshop/circumstantial.gd
+++ b/workshop/circumstantial.gd
@@ -33,7 +33,7 @@ static func _passive_survivor_floor(view: Dictionary, stage1_requested: Dictiona
 		var pid: String = str(p.get("id", ""))
 		if pid == "" or pid == listener_id or not p.get("alive", true):
 			continue
-		if pid in known_good or pid in victims or silenced_ids.has(pid):
+		if pid in known_good or pid in victims:  # MOCK: silenced people stay in the reference pool
 			continue
 		var v: float = float(stage1_requested.get(pid, 0.0))
 		all_vals.append(v)
diff --git a/workshop/public_evidence.gd b/workshop/public_evidence.gd
index e3db5ef..a2a17b5 100644
--- a/workshop/public_evidence.gd
+++ b/workshop/public_evidence.gd
@@ -57,6 +57,7 @@ static func factors(view: Dictionary) -> Array:
 	var prior = 0.3
 	var posterior = prior * (1.0 - 0.12 / 0.45)
 	var ratio = (posterior / (1.0 - posterior)) / (prior / (1.0 - prior))
+	ratio = 1.0  # MOCK (mock/silence-no-boost): a silencing says nothing about the silenced person
 	var seen = {}
 	for event in events:
 		var day: int = event.get("at", {}).get("day", -1)
