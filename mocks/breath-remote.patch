From 59b34792ce136d66ae7122a91070d36c3546ba8d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 21:15:48 -0500
Subject: [PATCH 2/2] MOCK, not for main: Breathstealer modes "remote" and
 "lasting" (this branch: remote)

remote: each day it silences its preferred target wherever they are (chosen in the
night), with no hunting; the town's presence reasoning and the circumstantial
silencing links are off, so a silence leaves no trail. lasting (mock/breath-lasting):
as on main, but no silence ends while an evil Breathstealer lives.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HbG76j4nGBcu8ZaA1UKmdr
---
 sim/roles/breathstealer.gd | 15 ++++++++++++---
 sim/world.gd               |  2 +-
 workshop/circumstantial.gd |  4 ++--
 workshop/day_presence.gd   |  2 ++
 4 files changed, 17 insertions(+), 6 deletions(-)

diff --git a/sim/roles/breathstealer.gd b/sim/roles/breathstealer.gd
index 00da84a..bf8d182 100644
--- a/sim/roles/breathstealer.gd
+++ b/sim/roles/breathstealer.gd
@@ -15,7 +15,10 @@ func _init() -> void:
 
 ## MOCK (mock/inert-breathstealer, not for main): an ability-less Minion. Dealt and played as
 ## a Breathstealer (team knowledge, bluffs, votes) but it never silences and never hunts.
-const INERT := true
+const INERT := false
+## MOCK modes: "" (as on main), "remote" (picks anyone each night, no block, no hunting, no
+## presence trail), "lasting" (as on main, but every silence lasts until it dies).
+const MODE := "remote"
 
 const PUBLIC: Array = ["tavern", "well", "chapel", "bakery", "wharf", "smithy", "mill", "graveyard"]
 
@@ -42,7 +45,7 @@ static func preferred_target(w, bs, evil):
 ## silenced today, it goes out to the public place on whose block the most good people are,
 ## rather than home or somewhere empty.
 func free_location(w, bs, idle: String, evil) -> String:
-	if INERT:
+	if INERT or MODE == "remote":
 		return idle
 	if not bs.alive or not bs.is_evil() or bs.breath_day == w.day or w.day < 1 or w.is_minion_suppressed():
 		return idle
@@ -133,7 +136,13 @@ func run_day_gift(w, bs, _mind, evil) -> void:
 		return
 	if w.is_minion_suppressed():
 		return  # the Sexton's bell: no silencing until the next night
-	var tgt: String = breath_target(w, bs, evil)
+	var tgt: String = ""
+	if MODE == "remote":
+		# Chosen in the night, anyone, whatever the block; it takes hold at the evening meeting.
+		var pick = preferred_target(w, bs, evil)
+		tgt = pick.id if pick != null else ""
+	else:
+		tgt = breath_target(w, bs, evil)
 	if tgt == "":
 		return
 	bs.breath_day = w.day
diff --git a/sim/world.gd b/sim/world.gd
index 1f654fa..20ee711 100644
--- a/sim/world.gd
+++ b/sim/world.gd
@@ -670,7 +670,7 @@ func start_phase() -> void:
 	if phase == C.EVENING:
 		# A silence lasts until the next evening.
 		for n in living():
-			if n.silenced and n.silence_day < day:
+			if n.silenced and n.silence_day < day and not (preload("res://sim/roles/breathstealer.gd").MODE == "lasting" and npcs.any(func(m): return m.alive and m.role == "breathstealer" and m.is_evil())):
 				n.silenced = false
 				dlog.add("silence_ends", "world", n.id, {}, "%s can speak again." % n.name)
 	for n in living():
diff --git a/workshop/circumstantial.gd b/workshop/circumstantial.gd
index 7bfb611..fc3efe3 100644
--- a/workshop/circumstantial.gd
+++ b/workshop/circumstantial.gd
@@ -154,7 +154,7 @@ static func extract_hub_incidents(
 			target_relevant[cid] = true
 
 		# 1. Silenced card itself pairs with a qualifying public proximity card on that day.
-		if kind == "context" and ctx == "silenced":
+		if kind == "context" and ctx == "silenced" and preload("res://sim/roles/breathstealer.gd").MODE != "remote":
 			var s_day: int = int(c.get("observed_at", {}).get("day", c.get("night", -1)))
 			var s_victim: String = str(c.get("subject", ""))
 			if s_victim != "" and s_victim != target and hub_cards.any(func(o):
@@ -182,7 +182,7 @@ static func extract_hub_incidents(
 				# Being near a silencing is no longer an incident here: Breathstealer by presence
 				# (workshop/day_presence.gd breath_factor) weighs it jointly across every
 				# silencing in CaseEval, so the card only stays relevant to the target.
-				for sv in silenced_map.get(day_num, []):
+				for sv in (silenced_map.get(day_num, []) if preload("res://sim/roles/breathstealer.gd").MODE != "remote" else []):
 					if sv == target:
 						continue
 					var direct_pair: bool = sv in subjs
diff --git a/workshop/day_presence.gd b/workshop/day_presence.gd
index 74cbfe1..3829cce 100644
--- a/workshop/day_presence.gd
+++ b/workshop/day_presence.gd
@@ -406,6 +406,8 @@ static var bare_reads_view: bool = true
 
 
 static func breath_factor(view: Dictionary, cards: Array = []) -> Dictionary:
+	if preload("res://sim/roles/breathstealer.gd").MODE == "remote":
+		return {}  # MOCK: a silence leaves no trail
 	var minions: Array = view.get("script_minions", [])
 	if not minions.is_empty() and "breathstealer" not in minions:
 		return {}
