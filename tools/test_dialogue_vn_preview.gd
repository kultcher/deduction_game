extends SceneTree

func _initialize() -> void:
	call_deferred("_run")

func _normalized(value: String) -> String:
	var whitespace = RegEx.new()
	whitespace.compile("\\s+")
	return whitespace.sub(value.replace("\u00a0", " "), " ", true).strip_edges()

func _run() -> void:
	var lab = load("res://ui/dialogue_lab.tscn").instantiate()
	root.add_child(lab)
	await process_frame
	var before: Dictionary = lab.memories.duplicate(true)
	lab._open_vn_preview()
	lab.vn_preview.set_process(false) # Advance reveal explicitly for deterministic timing checks.
	assert(lab.vn_preview.visible)
	assert(lab.vn_preview.speaker.text == "Agnes")
	assert(lab.vn_preview.speech.visible_characters == 0)
	assert(lab.vn_preview.reveal_total > 0)
	lab.vn_preview._process(0.1)
	assert(lab.vn_preview.speech.visible_characters == 9)
	lab.vn_preview.reveal_all()
	assert(lab.vn_preview.speech.visible_characters == -1)
	assert(_normalized(lab.vn_preview.speech.get_parsed_text()) == _normalized(lab.last_results.agnes.text))
	assert(lab.memories == before)
	lab.vn_preview.choices.select(1)
	lab.vn_preview.choices.item_selected.emit(1)
	assert(lab.vn_preview.speaker.text == "Bartholomew")
	assert(_normalized(lab.vn_preview.speech.get_parsed_text()) == _normalized(lab.last_results.bart.text))
	lab.vn_preview.speak_requested.emit()
	assert(_normalized(lab.vn_preview.speech.get_parsed_text()) == _normalized(lab.last_results.bart.text))
	var sample = {"bart": {"text": "Agnes says the Seer saw Constance.", "cue": ""}}
	lab.vn_preview.show_results(sample)
	var spans: Array = lab.vn_preview.formatter.format_text(sample.bart.text, {"surface": "paper", "speaker_id": "bart", "font_size": 26, "icon_size": 26})
	assert(spans.any(func(span): return span.entity_id == "person:agnes"))
	assert(spans.any(func(span): return span.entity_id == "role:seer" and not span.icon_path.is_empty()))
	assert(_normalized(lab.vn_preview.speech.get_parsed_text()) == _normalized(sample.bart.text))
	assert(lab.vn_preview.speech.visible_characters == 0)
	lab.vn_preview._process(10.0)
	assert(lab.vn_preview.speech.visible_characters == lab.vn_preview.reveal_total)
	# Expression changes do not reset dialogue and only Constance exposes the choices.
	lab.vn_preview.choices.select(2)
	lab.vn_preview.choices.item_selected.emit(2)
	assert(not lab.vn_preview.expression_choices.disabled)
	var expression_before: int = lab.vn_preview.speech.visible_characters
	lab.vn_preview.expression_choices.select(1)
	lab.vn_preview.expression_choices.item_selected.emit(1)
	assert(lab.vn_preview.portrait.texture == lab.vn_preview.EXPRESSIONS["Warm"])
	assert(lab.vn_preview.previous_portrait.visible)
	assert(lab.vn_preview.speech.visible_characters == expression_before)
	lab.vn_preview.expression_choices.select(2)
	lab.vn_preview.expression_choices.item_selected.emit(2)
	assert(lab.vn_preview.portrait.texture == lab.vn_preview.EXPRESSIONS["Harsh"])
	lab.vn_preview.fade_check.button_pressed = false
	assert(not lab.vn_preview.previous_portrait.visible)
	lab.vn_preview.expression_choices.select(3)
	lab.vn_preview.expression_choices.item_selected.emit(3)
	assert(lab.vn_preview.portrait.texture == lab.vn_preview.EXPRESSIONS["Worried"])
	assert(not lab.vn_preview.previous_portrait.visible)
	lab.vn_preview.choices.select(0)
	lab.vn_preview.choices.item_selected.emit(0)
	assert(lab.vn_preview.expression_choices.disabled)
	assert(lab.vn_preview.expression_choices.selected == 0)
	lab.vn_preview.hide()
	assert(not lab.vn_preview.visible)
	print("Dialogue VN preview checks passed")
	lab.queue_free()
	quit()
